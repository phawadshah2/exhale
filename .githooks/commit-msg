
clear
sh
# Enforce Conventional Commits (https://www.conventionalcommits.org).

first_line=$(head -n1 "$1")

# Merge and revert commits are generated by git; let them through.
case "$first_line" in
  Merge*|Revert*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore)(\([a-z0-9._-]+\))?!?: .{1,72}$'

if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo "✗ Commit message must follow Conventional Commits."
  echo
  echo "  <type>(<optional scope>): <subject>"
  echo "  types: feat fix docs style refactor perf test build ci chore"
  echo
  echo "  e.g.  feat(tasks): add due-date picker"
  echo "  got:  $first_line"
  exit 1
fi
